<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>互動上香裝置 - 財神趙公明</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #1a0800; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
#app {
  width: 100%; max-width: 420px; min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  font-family: 'Noto Serif TC', 'Noto Serif', 'Kaiti TC', serif;
  background: linear-gradient(180deg, #1a0800 0%, #2e1200 50%, #1a0800 100%);
  position: relative;
}
#header {
  width: 100%;
  background: linear-gradient(90deg, #5C3600, #B8820A, #E0B020, #B8820A, #5C3600);
  text-align: center; padding: 13px 0 11px;
  border-bottom: 2px solid #FFD060; flex-shrink: 0; z-index: 10;
}
#header h1 {
  font-size: 21px; font-weight: 700; color: #FFF5CC;
  letter-spacing: 8px; text-shadow: 0 1px 4px rgba(0,0,0,0.6);
}
#subtitle {
  font-size: 12px; color: #FFD89A; letter-spacing: 1px;
  padding: 8px 16px 4px; text-align: center;
  text-shadow: 0 1px 3px rgba(0,0,0,0.7); flex-shrink: 0;
}
#scene {
  width: 100%; flex: 1;
  position: relative;
  display: flex; flex-direction: column; align-items: center;
}
/* Container maintains 701:1000 aspect ratio */
#img-container {
  width: 100%;
  position: relative;
  padding-bottom: 142.7%; /* 1000/701 * 100 */
}
#deity-img, #hands-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: contain;
}
#deity-img { z-index: 1; }
#hands-img { z-index: 2; transition: transform 0.08s ease-out; }
#status-text {
  text-align: center; font-size: 17px; color: #FFE5A0;
  letter-spacing: 4px; padding: 8px 0 14px;
  min-height: 44px; z-index: 6;
  text-shadow: 0 1px 4px rgba(0,0,0,0.8);
}
#complete-overlay {
  display: none; position: absolute; inset: 0;
  background: rgba(8,2,0,0.88); z-index: 20;
  flex-direction: column; align-items: center;
  justify-content: center; gap: 18px;
}
#complete-overlay.show { display: flex; }
#complete-text {
  font-size: 30px; color: #FFD060; letter-spacing: 8px; font-weight: 700;
  text-shadow: 0 0 28px rgba(255,200,50,0.8);
}
#complete-sub {
  font-size: 14px; color: #FFE5A0; letter-spacing: 2px;
  text-align: center; line-height: 2.4;
}
#restart-btn {
  margin-top: 10px; padding: 12px 36px;
  background: linear-gradient(90deg, #7A5000, #C8900A, #7A5000);
  color: #FFF5CC; border: 1px solid #E0A020; border-radius: 30px;
  font-size: 15px; font-family: inherit; letter-spacing: 4px; cursor: pointer;
}
#tap-btn {
  display: none; margin: 4px auto 0; padding: 11px 32px;
  background: linear-gradient(90deg, #7A5000, #C8900A);
  color: #FFF5CC; border: 1px solid #E0A020; border-radius: 30px;
  font-size: 15px; font-family: inherit; letter-spacing: 4px; cursor: pointer;
}
</style>
</head>
<body>
<div id="app">
  <div id="header"><h1>上　香</h1></div>
  <div id="subtitle">誠心三拜後，點擊三下按鈕</div>
  <div id="scene">
    <div id="img-container">
      <img id="deity-img" src="data:image/png;base64," alt="財神趙公明"/>
      <img id="hands-img" src="data:image/png;base64," alt="持香雙手"/>
    </div>
    <div id="status-text">誠心三拜後，點擊三下按鈕</div>
    <button id="tap-btn">行　禮</button>
  </div>
  <div id="complete-overlay">
    <div id="complete-text">上香完畢</div>
    <div id="complete-sub">財神趙公明已感念心誠<br>祈願財源廣進，萬事如意</div>
    <button id="restart-btn">再次上香</button>
  </div>
</div>
<script>
const handsImg = document.getElementById('hands-img');
const statusText = document.getElementById('status-text');
const completeOverlay = document.getElementById('complete-overlay');
const restartBtn = document.getElementById('restart-btn');
const tapBtn = document.getElementById('tap-btn');
let completed=false, bowCount=0, phase='idle', lastY=null, peakY=null, troughY=null, lastAccelY=0;
const THRESHOLD=5, TARGET=3;

function animateBow(cb){
  const dur=450, start=Date.now();
  function step(){
    const p=Math.min((Date.now()-start)/dur,1);
    const v=Math.sin(p*Math.PI)*38;
    handsImg.style.transform='translateY('+(-v)+'px)';
    if(p<1) requestAnimationFrame(step);
    else { handsImg.style.transform=''; if(cb) cb(); }
  }
  requestAnimationFrame(step);
}

function doBow(){
  if(completed) return;
  animateBow(()=>{
    bowCount++;
    if(bowCount>=TARGET){
      completed=true; statusText.textContent='';
      setTimeout(()=>completeOverlay.classList.add('show'), 200);
    }
  });
}

function handleMotion(e){
  if(completed) return;
  const accel=e.accelerationIncludingGravity||e.acceleration;
  if(!accel) return;
  const y=accel.y||0;
  const delta=y-lastAccelY; lastAccelY=y;
  const visual=Math.max(-30,Math.min(30,-delta*2.8));
  handsImg.style.transform='translateY('+visual+'px)';
  if(lastY===null){lastY=y;return;}
  const diff=y-lastY;
  if(phase==='idle'||phase==='up'){if(diff<-THRESHOLD){phase='down';peakY=y;}}
  if(phase==='down'){if(diff>THRESHOLD){phase='returning';troughY=y;}}
  if(phase==='returning'){
    if(Math.abs(y-peakY)<4){
      const amp=Math.abs(peakY-troughY); phase='idle';
      if(amp>THRESHOLD*1.5) doBow();
    }
  }
  lastY=y;
}

function requestPermission(){
  if(typeof DeviceMotionEvent!=='undefined'&&typeof DeviceMotionEvent.requestPermission==='function'){
    DeviceMotionEvent.requestPermission().then(s=>{
      if(s==='granted') window.addEventListener('devicemotion',handleMotion);
      else showFallback();
    }).catch(showFallback);
  } else if(typeof DeviceMotionEvent!=='undefined'){
    window.addEventListener('devicemotion',handleMotion);
  } else showFallback();
}
function showFallback(){
  statusText.textContent='點擊按鈕模擬行禮';
  tapBtn.style.display='block';
}
tapBtn.onclick=()=>{if(!completed)doBow();};
restartBtn.onclick=()=>{
  bowCount=0;completed=false;phase='idle';lastY=null;peakY=null;troughY=null;
  statusText.textContent='請上下搖晃手機上香';
  completeOverlay.classList.remove('show');
  handsImg.style.transform='';
};
requestPermission();
</script>
</body>
</html>
